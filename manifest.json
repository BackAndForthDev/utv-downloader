{
  "manifest_version": 3,
  "name": "U-TV Downloader",
  "version": "1.0.0",
  "key": "",
  "description": "Pick seasons and episodes of u-tv.ru shows and download them at the best available quality.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "U-TV Downloader",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "downloads.open",
    "notifications",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.u-tv.ru/*",
    "https://u-tv.ru/*",
    "https://*.media1.ru/*",
    "http://*.media1.ru/*"
  ]
}
